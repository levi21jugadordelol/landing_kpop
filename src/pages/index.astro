---
import LandingLayout from '../layouts/LandingLayout.astro';
import { business } from '../data/business';
import HeroSection from '../sections/HeroSection.astro';
import CatalogSection from '../sections/CatalogSection.astro';
import DeliveriesSection from '../sections/DeliveriesSection.astro';
import TrustSection from '../sections/TrustSection.astro';
import HowToBuySection from '../sections/HowToBuySection.astro';
import FaqSection from '../sections/FaqSection.astro';
import FinalCtaSection from '../sections/FinalCtaSection.astro';
---

<LandingLayout
  title={`${business.name} | ${business.niche}`}
  description={business.subheadline}
>
  <HeroSection />
  <CatalogSection />
  <DeliveriesSection />
  <TrustSection />
  <HowToBuySection />
  <FaqSection />
  <FinalCtaSection />
</LandingLayout>
