---
import { faqs } from '../data/faqs';
---

<section class="landing-section landing-section--faq">
  <div class="section-shell section-shell--narrow">
    <div class="section-heading">
      <p class="section-eyebrow">Dudas frecuentes</p>
      <h2>Antes de escribir por WhatsApp</h2>
      <p>
        Respuestas rápidas para que el usuario llegue a la conversación con más
        confianza y menos fricción.
      </p>
    </div>

    <div class="faq-list">
      {
        faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
