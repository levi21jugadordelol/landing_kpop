---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Product } from '../data/products';
import { products, productStatusLabel } from '../data/products';
import btsImage from '../assets/catalogo/bts.jpg';
import blackpinkImage from '../assets/catalogo/black_pink.jpg';
import strayKidsImage from '../assets/catalogo/stary_kids.jpg';
import katseyeImage from '../assets/catalogo/katseye.jpg';
import twiceImage from '../assets/catalogo/twice.jpg';
import blackpinkBornPinkImage from '../assets/catalogo/albunes/black_pink/born_pink.jpg';
import blackpinkDeadlineImage from '../assets/catalogo/albunes/black_pink/dead_line.jpg';
import btsSoulImage from '../assets/catalogo/albunes/bts/soul.jpg';
import btsWingsImage from '../assets/catalogo/albunes/bts/wings.jpg';
import strayKidsKarmaImage from '../assets/catalogo/albunes/stray_kids/karma.jpg';
import strayKidsThisThatImage from '../assets/catalogo/albunes/stray_kids/this_that.jpg';
import {
  buildGroupWhatsAppLink,
  buildMoreGroupsWhatsAppLink,
  buildMoreProductsWhatsAppLink,
  buildProductWhatsAppLink,
} from '../scripts/whatsapp/links';

const productStatusClass = {
  available: 'status-pill status-pill--available',
  low_stock: 'status-pill status-pill--low',
  sold_out: 'status-pill status-pill--sold',
} as const;

type ProductGroup = {
  name: string;
  image: ImageMetadata;
  products: ProductView[];
};

type AvailableGroup = {
  name: string;
  image: ImageMetadata;
};

type ProductView = Product & {
  cover: ImageMetadata;
};

const availableGroups: AvailableGroup[] = [
  { name: 'BTS', image: btsImage },
  { name: 'Stray Kids', image: strayKidsImage },
  { name: 'BLACKPINK', image: blackpinkImage },
  { name: 'Katseye', image: katseyeImage },
  { name: 'Twice', image: twiceImage },
];

const groupImageByName = Object.fromEntries(
  availableGroups.map((group) => [group.name, group.image])
) as Record<string, ImageMetadata>;

const productImageById: Record<string, ImageMetadata> = {
  'album-01': btsSoulImage,
  'album-02': strayKidsKarmaImage,
  'album-03': blackpinkBornPinkImage,
  'album-04': btsWingsImage,
  'album-05': strayKidsThisThatImage,
  'album-06': blackpinkDeadlineImage,
};

const productsByGroup = products.reduce<Record<string, ProductView[]>>((acc, product) => {
  const key = product.group;

  if (!acc[key]) acc[key] = [];

  acc[key].push({
    ...product,
    cover: productImageById[product.id] ?? groupImageByName[product.group] ?? btsImage,
  });

  return acc;
}, {});

const groups: ProductGroup[] = availableGroups.map((group) => ({
  ...group,
  products: productsByGroup[group.name] ?? [],
}));
---

<section id="catalogo" class="landing-section landing-section--catalog">
  <div class="section-shell">
    <div class="section-heading">
      <p class="section-eyebrow">Mini catálogo</p>
      <h2>Busca por tu grupo favorito</h2>
      <p>
        Revisa qué grupos tenemos disponibles y consulta por WhatsApp los álbumes,
        versiones o photocards que te interesan.
      </p>
    </div>

    <div class="group-grid" data-catalog-groups aria-label="Grupos disponibles">
      {
        groups.map((group, index) => {
          return (
            <article
              class:list={['group-card', index === 0 && 'is-active']}
              data-group-card={group.name}
            >
              <button
                type="button"
                class="group-card__button"
                data-group-select={group.name}
                data-group-link={buildGroupWhatsAppLink(group.name)}
                data-group-title={`Muestra de ${group.name}`}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                <span class="group-card__media">
                  <Picture
                    src={group.image}
                    alt=""
                    formats={['avif', 'webp']}
                    widths={[320, 480, 640, 840]}
                    sizes="(min-width: 760px) 31vw, calc(100vw - 2rem)"
                    loading={index === 0 ? 'eager' : 'lazy'}
                  />
                </span>
                <span class="group-card__name">{group.name}</span>
                <span class="group-card__hint">{group.products.length > 0 ? 'Ver muestra' : 'Consultar grupo'}</span>
              </button>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<section
  id="productos-grupo"
  class="landing-section landing-section--selected-products"
  data-group-detail
>
  <div class="section-shell">
    <div class="group-detail">
      <div class="group-detail__header">
        <div>
          <p class="section-eyebrow">Vitrina por grupo</p>
          <h3 data-group-detail-title>
            {groups[0] ? `Muestra de ${groups[0].name}` : 'Muestra disponible'}
          </h3>
          <p>
            Una selección breve para que identifiques rápido el grupo y consultes
            versiones, álbumes o photocards por WhatsApp.
          </p>
        </div>
        <a
          href={groups[0] ? buildGroupWhatsAppLink(groups[0].name) : '#'}
          data-group-detail-link
        >
          Consultar {groups[0]?.name} por WhatsApp
        </a>
      </div>

      {
        groups.map((group, index) => (
          <div
            class:list={['group-product-panel', index === 0 && 'is-active']}
            data-group-panel={group.name}
          >
            {
              group.products.length > 0 ? (
                group.products.slice(0, 3).map((product) => (
                  <article class="product-card">
                    <div class="product-media">
                      <Picture
                        src={product.cover}
                        alt={`${product.group} - ${product.name}`}
                        formats={['avif', 'webp']}
                        widths={[260, 380, 520, 680]}
                        sizes="(min-width: 760px) 30vw, calc(100vw - 2rem)"
                        loading={index === 0 ? 'eager' : 'lazy'}
                      />
                    </div>

                    <div class="product-card__body">
                      <div class="product-card__meta">
                        <p>{product.category}</p>
                        <span class={productStatusClass[product.status]}>
                          {productStatusLabel[product.status]}
                        </span>
                      </div>

                      <h3>{product.name}</h3>

                      <ul class="product-proof" aria-label="Características del producto">
                        {product.version && <li>{product.version}</li>}
                        <li>Original</li>
                        <li>Consulta directa</li>
                      </ul>

                      <div class="product-card__footer">
                        <p>{product.price}</p>
                        <a href={buildProductWhatsAppLink(product)}>
                          Consultar por WhatsApp
                        </a>
                      </div>
                    </div>
                  </article>
                ))
              ) : (
                <article class="product-card product-card--empty">
                  <div class="product-media product-media--empty">
                    <Picture
                      src={group.image}
                      alt={`${group.name} - grupo disponible para consultar`}
                      formats={['avif', 'webp']}
                      widths={[260, 380, 520, 680]}
                      sizes="(min-width: 760px) 30vw, calc(100vw - 2rem)"
                      loading="lazy"
                    />
                  </div>

                  <div class="product-card__body">
                    <div class="product-card__meta">
                      <p>Grupo disponible</p>
                      <span class="status-pill status-pill--low">Por confirmar</span>
                    </div>

                    <h3>{group.name}</h3>

                    <ul class="product-proof" aria-label={`Estado de productos de ${group.name}`}>
                      <li>Álbumes por cargar</li>
                      <li>Consulta directa</li>
                    </ul>

                    <div class="product-card__footer">
                      <p>Consultar</p>
                      <a href={buildGroupWhatsAppLink(group.name)}>
                        Preguntar por WhatsApp
                      </a>
                    </div>
                  </div>
                </article>
              )
            }
          </div>
        ))
      }

      <div class="catalog-actions" aria-label="Más consultas por WhatsApp">
        <a href={buildMoreGroupsWhatsAppLink()} class="catalog-actions__secondary">
          Preguntar por otro grupo
        </a>
        <a href={buildMoreProductsWhatsAppLink()} class="catalog-actions__primary">
          Ver más opciones por WhatsApp
        </a>
      </div>
    </div>
  </div>

  <script>
    const catalog = document.querySelector('[data-catalog-groups]');
    const detail = document.querySelector('[data-group-detail]');
    const detailTitle = document.querySelector('[data-group-detail-title]');
    const detailLink = document.querySelector('[data-group-detail-link]');

    catalog?.addEventListener('click', (event) => {
      const button = event.target instanceof Element
        ? event.target.closest('[data-group-select]')
        : null;

      if (!(button instanceof HTMLButtonElement)) return;

      const selectedGroup = button.dataset.groupSelect;
      const selectedLink = button.dataset.groupLink;
      const selectedTitle = button.dataset.groupTitle;
      if (!selectedGroup) return;

      document.querySelectorAll('[data-group-card]').forEach((card) => {
        card.classList.toggle('is-active', card.getAttribute('data-group-card') === selectedGroup);
      });

      document.querySelectorAll('[data-group-select]').forEach((control) => {
        control.setAttribute(
          'aria-pressed',
          String(control.getAttribute('data-group-select') === selectedGroup)
        );
      });

      document.querySelectorAll('[data-group-panel]').forEach((panel) => {
        panel.classList.toggle('is-active', panel.getAttribute('data-group-panel') === selectedGroup);
      });

      if (detailTitle) detailTitle.textContent = selectedTitle ?? `Muestra de ${selectedGroup}`;
      if (detailLink instanceof HTMLAnchorElement && selectedLink) {
        detailLink.href = selectedLink;
        detailLink.textContent = `Consultar ${selectedGroup} por WhatsApp`;
      }

      detail?.scrollIntoView({
        block: 'start',
        behavior: 'smooth',
      });
    });
  </script>
</section>


